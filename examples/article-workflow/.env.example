# Local configuration only; Foundry injects its project endpoint when hosted.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1
AZURE_SQL_CONNECTION_STRING=Server=YOUR-SERVER.database.windows.net;Database=articles;Authentication=ActiveDirectoryDefault;Encrypt=yes;TrustServerCertificate=no;
AZURE_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE.blob.core.windows.net
AZURE_STORAGE_CONTAINER=articles
APPLICATIONINSIGHTS_CONNECTION_STRING=REPLACE-WITH-PROVISIONED-CONNECTION-STRING
OTEL_SERVICE_NAME=article-workflow
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=false
ENABLE_CONSOLE_EXPORTERS=false
